rules_version = '2';
// BORRADOR revisado contra el código (no desplegado).
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      // Mismos correos que firestore.rules y VITE_ADMIN_EMAILS.
      let adminEmails = ['contacto@borealabs.org', 'admin@borealabs.org', 'jose@borealabs.org'];
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.get('admin', false) == true
            || request.auth.token.get('email', '') in adminEmails
            // Admins agregados desde la sección Accesos (Firestore isAdmin/{correo}).
            || (firestore.exists(/databases/(default)/documents/isAdmin/$(request.auth.token.get('email', '')))
                && firestore.get(/databases/(default)/documents/isAdmin/$(request.auth.token.get('email', ''))).data.get('active', true) != false));
    }

    // Comprobantes de asistencia: subida pública, solo crear, imagen < 5 MB.
    match /attendance-proofs/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // get (no list): el formulario necesita getDownloadURL justo después de subir. La ruta lleva timestamp + nombre.
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Imágenes que adjunta quien se inscribe a un evento (campos personalizados tipo imagen).
    match /registration-uploads/{eventId}/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Foto que sube un miembro desde su enlace de invitación (pendiente de aprobación).
    match /team-pending/{token}/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.exists(/databases/(default)/documents/teamInvites/$(token));
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Imágenes que las páginas públicas resuelven con getDownloadURL (EventsPage, TeamPage).
    match /events/{path=**}       { allow read: if true; allow write: if isAdmin(); }
    match /team-members/{path=**} { allow read: if true; allow write: if isAdmin(); }

    // cert-templates/, partner_logos/, certificates/ y el resto: solo admin.
    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
